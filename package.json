{
  "name": "sentinel-pr",
  "version": "1.0.0",
  "description": "Autonomous, Safe Dependency Remediation Agent built on TrueForge & verified with Qodo",
  "main": "cli/sentinelpr.py",
  "type": "module",
  "scripts": {
    "start:mcp": "node mcp-servers/osv-mcp/server.mjs",
